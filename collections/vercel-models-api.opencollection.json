{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vercel AI Gateway Chat Models API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ai-gateway.vercel.sh/v1/models"
          },
          "docs": "Returns all available AI models accessible through the Vercel AI Gateway. Compatible with the OpenAI models API format."
        }
      ]
    }
  ],
  "bundled": true
}